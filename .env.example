# Copy to .env. `npm start` and the watchdog load this file.
# Variables already set in the process environment are kept.
# TELEGRAM_BOT_TOKEN=  (required; do not commit)

WEBAPP_URL=
PORT=8787
HOST=0.0.0.0

# Client URL and uvicorn bind. HOST/PORT overrides replace that part of the URL.
GEMINI_BRIDGE_URL=http://127.0.0.1:8765
# GEMINI_BRIDGE_HOST=127.0.0.1
# GEMINI_BRIDGE_PORT=8765

GEMINI_COOKIES_PATH=.cookies.json
GEMINI_PREFS_PATH=data/prefs.json
# ALLOWLIST_PATH=data/allowlist.json

# Past-chat history ("New chat" archives the old chat; archived chats are read-only).
# HISTORY_PATH=data/history.json
# HISTORY_MAX_CHATS=50
# HISTORY_MAX_MESSAGE_CHARS=20000
# HISTORY_TITLE_CHARS=40
# HISTORY_LIST_LIMIT=20
# HISTORY_PAGE_CHARS=3600

# Comma-separated Telegram usernames. These accounts cannot be removed with /deny.
PERMANENT_ADMINS=
ALLOWED_USERNAMES=
ALLOWED_USER_IDS=

# Optional paths and binaries. Defaults match this box when unset.
# PYTHON=.venv/bin/python
# EXEC_NODE=/exec-daemon/node
# GEMINI_COOKIE_SEED=/home/box/sand-data/chrome-cookie-seed.json
# CHROME_COOKIE_DBS=/home/box/chrome-profile/Fork-4/Default/Cookies:/home/box/chrome-profile/Fork-3/Default/Cookies:/home/box/chrome-profile/Default/Cookies
# GEMINI_WEBAPI_CACHE=/tmp/gemini_webapi
# TUNNEL_HOST=127.0.0.1
# SKIP_BRIDGE=1

# Stale-bridge self-heal. /health/deep is a short quota RPC; the watchdog
# restarts node and uvicorn after two failures, at most once per five minutes.
# GEMINI_DEEP_HEALTH_TIMEOUT=15
# DEEP_HEALTH_EVERY_S=180
# DEEP_HEALTH_CURL_TIMEOUT=20
# DEEP_FAILS_BEFORE_RESTART=2
# STALE_RESTART_COOLDOWN_S=300
# STOP_GRACE_S=4
# BRIDGE_STOP_GRACE_MS=4000

# Seconds passed to GeminiClient.init (library default is 450). A short timeout
# aborts replies that think before the first text, and the library then closes
# the shared connection.
# GEMINI_TIMEOUT=180

# Stop one chat turn, including a single default-model retry, after this many
# seconds and return a clear message. Does not close the shared client.
# TURN_TIMEOUT=240
